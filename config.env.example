# ─────────────────────────────────────────────────────────────
# Server Status Monitor — collector config.
# Copy to  config.env  next to collector.sh (sourced by the root cron).
# ─────────────────────────────────────────────────────────────

# REQUIRED. Web account that owns the data feed. Root writes the snapshot to
# /home/<WEB_USER>/.proc_snapshot and chowns it to this user so the dashboard
# (running as this user under CageFS) can read it.
WEB_USER=myuser

# Where the collector keeps its caches (versions, disk-usage, imunify, smart).
# Default: the collector's own directory.
DATA_DIR=/root/server-status-monitor

# The git checkout you installed from. The collector reads the local revision
# every run (cheap, offline) and checks the remote once a day, so the dashboard
# can show "update available" and log the dashboard's own updates — including
# the ones you apply by hand with `bash update.sh`. Leave it out and both are
# simply absent. The installer fills it in.
REPO_DIR=/root/server-status-monitor

# Apply updates automatically. OFF by default. When 1, the once-a-day check runs
# `update.sh` in a detached process if the checkout is behind. There is no button
# in the dashboard and nothing web-facing can trigger it — only the root cron.
AUTO_UPDATE=0
