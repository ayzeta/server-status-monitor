<?php
// ─────────────────────────────────────────────────────────────
// Server Status Monitor — dashboard config.
// Copy to  config.php  next to index.php. The dashboard runs with sane
// defaults if this file is absent; every key below is optional.
// ─────────────────────────────────────────────────────────────
return [
    // Web account PHP runs as (the CageFS user). Data files are read from its
    // home: /home/<web_user>/.proc_snapshot etc. If omitted, it is auto-detected
    // from the running PHP user (correct on cPanel/CageFS).
    'web_user'      => 'myuser',

    // Optional: override the home dir explicitly (default: /home/<web_user>).
    // 'home_dir'   => '/home/myuser',

    // ── Branding ──────────────────────────────────────────────
    'site_title'    => 'Infrastructure Monitor',
    'site_subtitle' => 'example.com — Real-time server health',

    // Default UI language: 'en' or 'tr'. The language button in the header sets
    // a cookie that overrides this per browser; the mail attachment (no cookie)
    // always uses this value.
    'lang'          => 'en',

    // Logo shown in the header (empty → two-letter initials from the title).
    'logo_url'      => '', // e.g. 'https://example.com/img/logo.png'

    // Favicon: healthy state uses this image; problem states draw it on an
    // orange/red tile. Must be same-origin as the dashboard for the colored
    // tile to render (cross-origin taints the canvas → falls back to initials).
    // Empty → a generated colored tile with the title initial.
    'favicon_url'   => '', // e.g. 'https://example.com/img/favicon-96.png'

    // ── Access key (optional) ─────────────────────────────────
    // When set, every request must carry the key: open ?key=YOUR-KEY once in the
    // browser (a cookie remembers it), and append it to integration URLs —
    // CSF: PT_APACHESTATUS = "https://.../status/?key=YOUR-KEY"
    // WHMCS status address:  https://.../status/?raw=1&key=YOUR-KEY
    // Empty = disabled. Use a long random string. Combines with the .htaccess
    // IP allowlist (see README "Securing the dashboard").
    // 'access_key' => '',

    // ── Line rate (optional) ──────────────────────────────────
    // Contracted bandwidth in Mbps, used as the denominator of the Network
    // IN/OUT percentage. Leave it out and the NIC's own link speed is used
    // instead — the card then reads "% of NIC speed" rather than "% of line".
    // Set it when the provider shapes the line below the card's capability: a
    // 1 Gbit NIC on a 500 Mbit line otherwise reads half empty and the warning
    // thresholds never fire. Shaping happens upstream and cannot be measured
    // from the server, so nothing here is guessed.
    // 'line_mbps'  => 500,                  // all interfaces
    // 'line_mbps'  => ['eth0' => 500],      // or per interface

    // ── Thresholds (optional) ─────────────────────────────────
    // Override any alert/color threshold; unlisted keys keep their defaults.
    // The same values drive the server render, the CSF mail attachment, and
    // the live 30s ticks — one source. Full key list & defaults: README
    // "Thresholds". Examples:
    // 'thresholds' => [
    //     'ram_warn'   => 80,   // % (default 70)
    //     'shmem_warn' => 50,   // % of RAM under memory pressure (default 40)
    //     'ssl_warn'   => 30,   // days left — only set this to override the
    //                           // issuer-based default. A certificate that
    //                           // renews itself should not be warned about
    //                           // while the renewal window is still open:
    //                           // AutoSSL starts renewing a Let's Encrypt cert
    //                           // 29 days out and a cPanel one 15 days out, so
    //                           // the defaults are 14/5 and 7/3 respectively —
    //                           // by then renewal has been failing for days.
    //                           // Any other issuer keeps 30/7, because a
    //                           // hand-installed or commercial certificate is
    //                           // renewed by a person who needs the notice.
    // ],

    // ── Keep the screen awake — DEFAULT only ──────────────────
    // There is a button for this in the header; each browser remembers its own
    // choice, because it is a property of the screen, not of the server. This
    // setting is only what a browser that has never pressed the button gets.
    // Set it true for a wall display that should come up lit after a reboot.
    // It cannot switch off the browser's own "efficiency mode" or "sleeping
    // tabs" — there is no web API for that; see the README.
    'keep_awake'    => false,

    // ── Footer credit (optional) ──────────────────────────────
    // Small attribution link in the footer. Set to your own, or '' to hide.
    'credit_text'   => 'Ayzeta',
    'credit_url'    => 'https://ayzeta.net',
];
